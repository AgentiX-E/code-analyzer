{
  "name": "code-analyzer",
  "version": "0.1.0",
  "description": "Code intelligence platform — knowledge graph analysis, PR review, and cross-repo intelligence for AI agents",
  "author": "Lambertyan",
  "license": "MIT",
  "keywords": [
    "code-analysis",
    "knowledge-graph",
    "mcp",
    "code-review",
    "tree-sitter",
    "static-analysis",
    "ai-agent",
    "copilot",
    "cross-repo",
    "pr-review"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AgentiX-E/code-analyzer.git"
  },
  "homepage": "https://github.com/AgentiX-E/code-analyzer",
  "bugs": {
    "url": "https://github.com/AgentiX-E/code-analyzer/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "packages/*/dist",
    "packages/*/package.json"
  ],
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "test:unit": "vitest run",
    "test:coverage": "c8 --reporter=text --reporter=json --reports-dir=./coverage --include='packages/shared/src/**/*.ts' --include='packages/core/src/**/*.ts' --include='packages/infra/src/**/*.ts' --include='packages/analyzer/src/**/*.ts' --include='packages/intelligence/src/**/*.ts' --include='packages/mcp/src/**/*.ts' --include='packages/server/src/**/*.ts' --include='packages/cli/src/**/*.ts' --exclude='**/*.test.ts' --exclude='**/__tests__/**' --exclude='**/index.ts' --exclude='**/provider.ts' --exclude='**/fixtures/**' --exclude='**/benchmarks/**' --exclude='packages/infra/src/storage/types.ts' --exclude='packages/core/src/agents/types.ts' --exclude='packages/infra/src/filesystem/watcher.ts' --exclude='packages/analyzer/src/languages/tree-sitter-base.ts' --exclude='packages/analyzer/src/languages/base-c-like.ts' --exclude='packages/analyzer/src/languages/typescript.ts' --exclude='packages/analyzer/src/languages/javascript.ts' --exclude='packages/analyzer/src/languages/python.ts' --exclude='packages/analyzer/src/languages/go.ts' --exclude='packages/analyzer/src/languages/java.ts' --exclude='packages/analyzer/src/languages/kotlin.ts' --exclude='packages/analyzer/src/languages/csharp.ts' --exclude='packages/analyzer/src/languages/rust.ts' --exclude='packages/analyzer/src/languages/php.ts' --exclude='packages/analyzer/src/languages/ruby.ts' --exclude='packages/analyzer/src/languages/swift.ts' --exclude='packages/*/dist/**' npx vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:property": "vitest run --config vitest.property.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "bench": "vitest bench",
    "bench:ci": "vitest bench --run --reporter=json > bench-results.json",
    "check:perf": "node scripts/check-benchmarks.js",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo build && changeset publish",
    "publish": "turbo build && pnpm -r publish --access public --no-git-checks"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-istanbul": "^3",
    "@vitest/coverage-v8": "3.2.7",
    "c8": "^12.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "fast-check": "^3.23.2",
    "prettier": "^3.9.6",
    "turbo": "^2.10.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "tree-sitter": "^0.25.0",
    "tree-sitter-c-sharp": "^0.21.3",
    "tree-sitter-go": "^0.21.2",
    "tree-sitter-java": "^0.21.0",
    "tree-sitter-javascript": "^0.21.4",
    "tree-sitter-kotlin": "^0.3.8",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.21.0",
    "tree-sitter-swift": "^0.7.1",
    "tree-sitter-typescript": "^0.21.2"
  }
}
