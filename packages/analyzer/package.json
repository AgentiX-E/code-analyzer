{
  "name": "@code-analyzer/analyzer",
  "version": "0.1.0",
  "description": "Code analysis engine for Code Analyzer",
  "author": "Lambertyan",
  "license": "MIT",
  "keywords": [
    "code-analysis",
    "static-analysis",
    "ast",
    "tree-sitter",
    "scope-resolution",
    "unified-parser",
    "code-intelligence"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AgentiX-E/code-analyzer.git",
    "directory": "packages/analyzer"
  },
  "bugs": {
    "url": "https://github.com/AgentiX-E/code-analyzer/issues"
  },
  "homepage": "https://github.com/AgentiX-E/code-analyzer#readme",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentix-e/embed-code-core": "0.1.1",
    "@agentix-e/embed-code-node": "0.1.1",
    "@code-analyzer/core": "workspace:*",
    "@code-analyzer/infra": "workspace:*",
    "@code-analyzer/shared": "workspace:*",
    "@eagleoutice/tree-sitter-r": "^1.1.2",
    "@tree-sitter-grammars/tree-sitter-hcl": "^1.2.0",
    "@tree-sitter-grammars/tree-sitter-markdown": "^0.3.2",
    "tree-sitter": "^0.25.0",
    "tree-sitter-bash": "^0.25.1",
    "tree-sitter-c": "^0.24.0",
    "tree-sitter-c-sharp": "^0.21.0",
    "tree-sitter-cpp": "^0.23.0",
    "tree-sitter-css": "^0.25.0",
    "tree-sitter-dart": "^1.0.0",
    "tree-sitter-elixir": "^0.3.0",
    "tree-sitter-go": "^0.21.0",
    "tree-sitter-groovy": "^0.1.2",
    "tree-sitter-html": "^0.23.2",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.21.0",
    "tree-sitter-json": "^0.24.8",
    "tree-sitter-kotlin": "^0.3.8",
    "tree-sitter-lua": "^2.1.3",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.21.0",
    "tree-sitter-scala": "^0.23.0",
    "tree-sitter-sql": "^0.1.0",
    "tree-sitter-swift": "^0.7.1",
    "tree-sitter-toml": "^0.5.1",
    "tree-sitter-typescript": "^0.23.2",
    "tree-sitter-yaml": "^0.5.0",
    "tree-sitter-zig": "^0.1.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
