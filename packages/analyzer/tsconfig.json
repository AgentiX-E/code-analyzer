{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "declarationDir": "./dist",
    "composite": true,
    "noUncheckedIndexedAccess": false,
    "noPropertyAccessFromIndexSignature": false,
    "noUnusedLocals": false,
    "strictNullChecks": false
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/__tests__"
  ],
  "references": [
    {
      "path": "../shared"
    },
    {
      "path": "../core"
    },
    {
      "path": "../infra"
    }
  ]
}
