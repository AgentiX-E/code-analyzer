{
  "name": "@code-analyzer/mcp",
  "version": "0.1.0",
  "description": "MCP server for Code Analyzer",
  "author": "Lambertyan",
  "license": "MIT",
  "keywords": [
    "code-analysis",
    "mcp",
    "model-context-protocol",
    "code-review",
    "cypher",
    "agent-tools",
    "code-intelligence"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AgentiX-E/code-analyzer.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/AgentiX-E/code-analyzer/issues"
  },
  "homepage": "https://github.com/AgentiX-E/code-analyzer#readme",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@code-analyzer/shared": "workspace:*",
    "@code-analyzer/core": "workspace:*",
    "@code-analyzer/infra": "workspace:*",
    "@code-analyzer/analyzer": "workspace:*",
    "@code-analyzer/intelligence": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
