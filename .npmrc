# Skip onnxruntime-node's GPU provider download during install.
#
# onnxruntime-node@1.27.0's postinstall downloads CUDA/TensorRT EP binaries
# (libonnxruntime_providers_cuda.so / _tensorrt.so) from the ORT-Nightly Nuget
# feed for linux/x64. This download intermittently times out in CI (ETIMEDOUT
# to aiinfra.pkgs.visualstudio.com) and blocks every `pnpm install` job. The
# CPU inference binaries are already bundled in the npm package, and CI runners
# have no GPU, so the GPU providers are never needed. `onnxruntime-node-install`
# maps to npm_config_onnxruntime_node_install, which install.js reads as
# INSTALL_FLAG=false and exits without downloading.
onnxruntime-node-install=skip
