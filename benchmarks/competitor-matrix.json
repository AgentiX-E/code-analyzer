  "ourMetrics": {
    "review.f1.martian": {
      "category": "A",
      "axis": "review F1 on the field's corpus",
      "artifact": "benchmarks/semantic-rescore.json",
      "read": [
        "rows",
        0,
        "f1"
      ],
      "note": "the best filter's F1 under our judge"
    },
    "review.findingsPerKLine": {
      "category": "A",
      "axis": "findings per 1,000 lines on the field's repositories",
      "artifact": "benchmarks/competitor-corpus.json",
      "read": [
        "findingsPerThousandLines"
      ],
      "note": "produced in CI as an artifact; absent from a local checkout, and reported as such"
    },
    "retrieval.lexical.recall": {
      "category": "C",
      "axis": "lexical search recall",
      "artifact": "benchmarks/lexical-search-recall.json",
      "read": [
        "recall"
      ]
    },
    "retrieval.docstring.recall.withVectors": {
      "category": "C",
      "axis": "docstring search recall with vectors registered",
      "artifact": "benchmarks/docstring-search.json",
      "read": [
        "withVectorsRegistered",
        "recall"
      ],
      "invalidWhen": {
        "path": [
          "withVectorsRegistered",
          "backend"
        ],
        "equals": "none"
      },
      "note": "the artifact itself says a `none` backend makes this the lexical figure again"
    },
    "indexing.secondsPerMillionLines": {
      "category": "A",
      "axis": "indexing seconds per million lines",
      "artifact": "benchmarks/indexing-speed.json",
      "read": [
        "lowerBound",
        "secondsPerMillionLines"
      ],
      "invalidWhen": {
        "path": [
          "valid"
        ],
        "equals": false
      },
      "note": "the artifact sets `valid: false` \u2014 the run hit its timeout, so this is a lower bound and not a rate"
    },
    "tokens.reduction": {
      "category": "A",
      "axis": "token reduction versus a full-context baseline",
      "artifact": "benchmarks/token-reduction.json",
      "read": [
        "tokenReduction"
      ]
    },
    "quality.languageCoverage": {
      "category": "A",
      "axis": "providers whose output has been scored",
      "artifact": "benchmarks/language-quality.json",
      "read": [
        "measuredCount"
      ],
      "note": "languages whose provider output has been scored against a reference"
    },
    "review.f1.martian.ourRow": {
      "category": "A",
      "axis": "our review F1 under the field harness and its own judge",
      "artifact": "benchmarks/martian-our-row.json",
      "read": [
        "f1"
      ],
      "note": "produced in CI; the artifact is written by the harness job from its evaluations file"
    },
    "review.f1.aacr": {
      "category": "A",
      "axis": "our review F1 on a competitor's published corpus",
      "artifact": "benchmarks/aacr-bench.json",
      "read": [
        "f1"
      ],
      "note": "the corpus carries Repo Level ground truth, which is the cross-file axis"
    }
  },
  "pendingOurMetrics": {
    "review.f1.martian.fieldComparison": {
      "category": "A",
      "artifact": "benchmarks/field-comparison.json",
      "why": "the job scores the whole field with one judge; no artifact yet"
    },
    "qa.accuracy.crossCodeEval": {
      "category": "C",
      "why": "needs a QA surface backed by an embedding backend, which is not wired"
    },
    "qa.accuracy.longCodeArena": {
      "category": "C",
      "why": "same prerequisite"
    },
    "sast.recall.owasp": {
      "category": "B",
      "why": "no SAST category comparison exists"
    },
    "sast.precision.primevul": {
      "category": "B",
      "why": "same"
    },
    "review.f1.crBench": {
      "category": "A",
      "why": "CR-Bench is not wired"
    },
    "review.f1.macroscope": {
      "category": "A",
      "why": "Macroscope's corpus is not wired"
    }
  }
