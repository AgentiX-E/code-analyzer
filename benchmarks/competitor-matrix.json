    "retrieval.lexical.recall": {
      "category": "C",
      "axis": "lexical search recall",
      "artifact": "benchmarks/lexical-search-recall.json",
      "read": ["recall"]
    },
    "retrieval.docstring.recall.withVectors": {
      "category": "C",
      "axis": "docstring search recall with vectors registered, at the product default weight",
      "artifact": "benchmarks/docstring-search.json",
      "read": ["fused", "recallAt20"],
      "invalidWhen": {
        "path": ["space", "semantic"],
        "equals": false
