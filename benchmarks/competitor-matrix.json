      "note": "the artifact reports a lexical column, a sweep and the row the product runs; `space.semantic: false` means either side of the cosine was the hash fallback, which makes every column the lexical figure again"
    },
    "indexing.secondsPerMillionLines": {
      "category": "A",
      "axis": "indexing seconds per million lines",
      "artifact": "benchmarks/indexing-speed.json",
